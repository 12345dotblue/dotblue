{
  "version": 1,
  "organization": {
    "name": "dotblue",
    "displayName": "dotblue",
    "websiteUrl": "https://dotblue.ai",
    "logo": "https://your-web-host.example.com/brand/dotblue-logo.png",
    "favicon": "https://your-web-host.example.com/brand/dotblue-favicon.svg",
    "defaultApplication": "dotblue",
    "themeData": {
      "themeType": "default",
      "colorPrimary": "#1677FF",
      "borderRadius": 12,
      "isCompact": false,
      "isEnabled": true
    }
  },
  "application": {
    "name": "dotblue",
    "displayName": "dotblue",
    "title": "dotblue",
    "description": "AI agent workspace for teams",
    "organization": "dotblue",
    "homepageUrl": "https://your-web-host.example.com",
    "logo": "https://your-web-host.example.com/brand/dotblue-logo.png",
    "favicon": "https://your-web-host.example.com/brand/dotblue-favicon.svg",
    "defaultGroup": "admin",
    "redirectUris": [
      "https://your-web-host.example.com/callback"
    ],
    "signinUrl": "",
    "signupUrl": "",
    "forgetUrl": "",
    "formCss": "",
    "formSideHtml": "<div style=\"display:flex;flex-direction:column;justify-content:flex-end;min-height:640px;padding:52px;background:linear-gradient(180deg, rgba(15,23,42,0.10), rgba(15,23,42,0.42)), url('https://your-web-host.example.com/brand/dotblue-login-bg.png') center/cover no-repeat;color:#fff;\"><div style=\"max-width:430px;\"><img src=\"https://your-web-host.example.com/brand/dotblue-logo.png\" alt=\"dotblue\" style=\"width:168px;max-width:100%;height:auto;display:block;margin-bottom:22px;\" /><div style=\"display:inline-flex;align-items:center;padding:6px 12px;border-radius:999px;background:rgba(255,255,255,0.16);font-size:12px;font-weight:600;letter-spacing:.08em;margin-bottom:18px;\">ENTERPRISE AI ASSISTANTS</div><h2 style=\"margin:0 0 14px;font-size:36px;line-height:1.1;color:#fff;\">Launch secure AI workspaces with dotblue</h2><p style=\"margin:0 0 18px;font-size:15px;line-height:1.8;color:rgba(255,255,255,0.88);\">Unified login, runtime governance, and ready-to-launch assistant experiences for product, operations, and growth teams.</p><div style=\"display:flex;flex-direction:column;gap:10px;\"><div style=\"display:flex;align-items:center;gap:10px;font-size:14px;line-height:1.5;color:rgba(255,255,255,0.90);\"><span style=\"width:8px;height:8px;border-radius:999px;background:#7dd3fc;display:inline-block;flex-shrink:0;\"></span><span>Casdoor powered branded access</span></div><div style=\"display:flex;align-items:center;gap:10px;font-size:14px;line-height:1.5;color:rgba(255,255,255,0.90);\"><span style=\"width:8px;height:8px;border-radius:999px;background:#7dd3fc;display:inline-block;flex-shrink:0;\"></span><span>Enterprise-ready assistant workspace</span></div><div style=\"display:flex;align-items:center;gap:10px;font-size:14px;line-height:1.5;color:rgba(255,255,255,0.90);\"><span style=\"width:8px;height:8px;border-radius:999px;background:#7dd3fc;display:inline-block;flex-shrink:0;\"></span><span>Deployment and runtime governance built in</span></div></div></div></div>",
    "formBackgroundUrl": "https://your-web-host.example.com/brand/dotblue-login-bg.png",
    "themeData": {
      "themeType": "default",
      "colorPrimary": "#1677FF",
      "borderRadius": 12,
      "isCompact": false,
      "isEnabled": true
    },
    "enablePassword": true,
    "enableSignUp": true,
    "disableSignin": false,
    "enableSigninSession": false,
    "enableAutoSignin": false
  },
  "admin": {
    "username": "admin",
    "displayName": "Platform Admin",
    "email": "admin@example.com",
    "passwordEnv": "DOTBLUE_ADMIN_PASSWORD"
  },
  "platform": {
    "dataBasePath": "/var/lib/dotblue/agents",
    "dataMountPath": "/var/lib/dotblue/agents",
    "containerPort": 8642,
    "newEnterprisePlatformCredits": 1000,
    "defaultCreditSettlementCurrency": "USD",
    "runtimeMode": "host",
    "endpointMode": "host_loopback",
    "dockerEndpoint": "",
    "dockerNetwork": ""
  },
  "provider": {
    "type": "openai",
    "apiBase": "https://api.openai.com/v1",
    "apiKeyEnv": "DOTBLUE_LLM_API_KEY",
    "model": "gpt-4.1-mini"
  }
}
