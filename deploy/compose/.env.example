COMPOSE_PROJECT_NAME=dotblue

GO_MODULE_PROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:7-alpine

CASDOOR_PORT=18000
CASDOOR_PUBLIC_URL=http://localhost:18000
CASDOOR_INTERNAL_URL=http://casdoor:8000
CASDOOR_ORG_NAME=dotblue
CASDOOR_APP_NAME=dotblue
CASDOOR_DB_NAME=casdoor
CASDOOR_DB_USER=casdoor
CASDOOR_DB_PASSWORD=change-me-casdoor-db-password

DOTBLUE_WEB_PORT=19000
DOTBLUE_PUBLIC_URL=http://localhost:19000
DOTBLUE_BACKEND_PORT=18080
DOTBLUE_BACKEND_PUBLIC_URL=http://localhost:18080
DOTBLUE_BACKEND_INTERNAL_URL=http://dotblue:8000
DOTBLUE_DB_NAME=dotblue
DOTBLUE_DB_USER=dotblue
DOTBLUE_DB_PASSWORD=change-me-dotblue-db-password
DOTBLUE_ENGINE_HOST_DATA_PATH=./.runtime/agents-host
DOTBLUE_ENGINE_MOUNT_DATA_PATH=/runtime-data
DOTBLUE_ENGINE_RUNTIME_MODE=container
DOTBLUE_ENGINE_ENDPOINT_MODE=docker_dns
DOTBLUE_ENGINE_DOCKER_ENDPOINT=unix:///var/run/docker.sock
DOTBLUE_ENGINE_DOCKER_NETWORK=
# Optional override when prepare-config cannot auto-detect the docker.sock group id.
# DOTBLUE_ENGINE_DOCKER_SOCKET_GID=999

DOTBLUE_ADMIN_USERNAME=admin
DOTBLUE_ADMIN_DISPLAY_NAME=Platform Admin
DOTBLUE_ADMIN_EMAIL=admin@example.com
DOTBLUE_ADMIN_PASSWORD=change-me-strong-admin-password

DOTBLUE_LLM_PROVIDER_TYPE=openai
DOTBLUE_LLM_API_BASE=https://api.openai.com/v1
DOTBLUE_LLM_API_KEY=
DOTBLUE_LLM_MODEL=gpt-4.1-mini

DOTBLUE_THEME_PRIMARY=#1677FF
DOTBLUE_BRAND_NAME=dotblue

# Runtime client and cert values are generated by prepare-config scripts.
